          <datasource-dependencies datasource='federated.10gkjpb1b4lygg106228z03zitbj'>
            <column caption='_MEASURE_VMT' datatype='real' name='[Calculation_1097470949062107136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;vehicle-distance_traveled&apos; THEN [value] ELSE 0 end ) }' />
            </column>
            <column caption='_MEASURE_CO2' datatype='real' name='[Calculation_1113233534276460576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;co2&apos; THEN [value] ELSE 0 end ) }' />
            </column>
            <column caption='_MEASURE_DOLLAR_COST' datatype='real' name='[Calculation_1113233534276599841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;transport_cost&apos; THEN [value] ELSE 0 end ) }' />
            </column>
            <column caption='Perc_Diff_Dollar_Cost' datatype='real' name='[Calculation_2169046210418266115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Summary_VMT (copy)_130885902615666693] / ABS(LOOKUP(ZN(SUM([Calculation_1113233534276599841])), FIRST()))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Bool_Show_Perc_Difference' datatype='boolean' name='[Calculation_788692939453505539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &quot;Percent Difference&quot;' />
            </column>
            <column caption='Perc_Diff_CO2' datatype='real' name='[Diff_CO2 (copy)_2169046210420592651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Summary_CO2 (copy)_2169046210419511301] / ABS(LOOKUP(ZN(SUM([Calculation_1113233534276460576])), FIRST()))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Perc_Diff_VMT' datatype='real' name='[Diff_VMT (copy)_2169046210420391946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Summary_VMT (copy)_2169046210419646470] / ABS(LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST()))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Perc_Diff_Fuel_Burn' datatype='real' name='[Perc_Diff_Dollar_Cost (copy)_2169046210420117513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Summary_Fuel_Burn (copy)_2169046210419724295] / ABS(LOOKUP(ZN(SUM([_MEASURE_CO2 (copy)])), FIRST()))'>
                <table-calc ordering-type='Rows' />
              </calculation>
