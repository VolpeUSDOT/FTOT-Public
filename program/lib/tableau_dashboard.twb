    <worksheet name='Quantity - Percentage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Optimal vs. Non-Optimal Commodity Quantity (as Percent of Available Quantity)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000'>Notes: (1) Bar chart shows supply and demand only. (2) Utilization includes stranded facilities while the main text report excludes stranded facilities.</run>
          </formatted-text>
        </caption>
        <alt-text>
          <formatted-text>
            <run>A stacked bar chart showing the share of commodity quantity that is optimal and non-optimal, by commodity supplied and commodity demanded.</run>
          </formatted-text>
        </alt-text>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_report.csv' name='federated.10gkjpb1b4lygg106228z03zitbj' />
            <datasource caption='facilities_merge (in fGDB)' name='federated.0w6r3991xjsayc1h2x9ss08urjyr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Commodity Quantity' caption='Utilization Units' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Commodity Quantity&quot;'>
              <calculation class='tableau' formula='&quot;Commodity Quantity&quot;' />
              <aliases>
                <alias key='&quot;Commodity Quantity&quot;' value='Commodity Quantity' />
                <alias key='&quot;Facilities&quot;' value='Facilities' />
              </aliases>
            </column>
            <column alias='Absolute Value' caption='Utilization Measure' datatype='string' name='[Utilization Units (copy)_2447706439878758400]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Value&quot;'>
              <calculation class='tableau' formula='&quot;Absolute Value&quot;' />
              <aliases>
                <alias key='&quot;Absolute Value&quot;' value='Absolute Value' />
                <alias key='&quot;Percent of Total&quot;' value='Percent of Total' />
              </aliases>
            </column>
            <column caption='Processor Measure' datatype='string' name='[_Demand_or_Supply Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Input&quot;'>
              <calculation class='tableau' formula='&quot;Input&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w6r3991xjsayc1h2x9ss08urjyr'>
            <column caption='_Demand_or_Supply' datatype='string' name='[Calculation_120752824411402243]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; &#13;&#10;OR [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; &#13;&#10;OR [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_input_capacity&apos;&#13;&#10;OR [measure] = &apos;processor_input_optimal&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_output_capacity&apos;&#13;&#10;OR [measure] = &apos;processor_output_optimal&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='_Demand_or_Supply (param)' datatype='string' name='[_Demand_or_Supply (copy)_1320680640681058304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; &#13;&#10;OR [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; &#13;&#10;OR [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF ([measure] = &apos;processor_input_capacity&apos; OR [measure] = &apos;processor_input_optimal&apos;)&#13;&#10;AND [Parameters].[_Demand_or_Supply Parameter] = &apos;Input&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;&#13;&#10;ELSEIF ([measure] = &apos;processor_output_capacity&apos; OR [measure] = &apos;processor_output_optimal&apos;)&#13;&#10;AND [Parameters].[_Demand_or_Supply Parameter] = &apos;Output&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Destination&quot;' value='Dest' />
                <alias key='&quot;Processor (Input)&quot;' value='Proc (Input)' />
                <alias key='&quot;Processor (Output)&quot;' value='Proc (Output)' />
                <alias key='&quot;Raw Material Producer&quot;' value='RMP' />
              </aliases>
            </column>
            <column datatype='string' name='[facility_name (tableau_report.csv)]' role='dimension' type='nominal' />
            <column caption='Measure' datatype='string' name='[measure]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;destination_demand_optimal&quot;' value='Fulfilled Demand' />
                <alias key='&quot;destination_demand_potential&quot;' value='Total Demand' />
                <alias key='&quot;processor_input_capacity&quot;' value='Processor Capacity (Input)' />
                <alias key='&quot;processor_input_optimal&quot;' value='Processor (Input)' />
                <alias key='&quot;processor_output_capacity&quot;' value='Processor Capacity (Output)' />
                <alias key='&quot;processor_output_optimal&quot;' value='Processor (Output)' />
                <alias key='&quot;rmp_supply_optimal&quot;' value='Used Supply' />
                <alias key='&quot;rmp_supply_potential&quot;' value='Available Supply' />
              </aliases>
            </column>
            <column caption='Mode' datatype='string' name='[mode]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_120752824411402243]' derivation='None' name='[none:Calculation_120752824411402243:nk]' pivot='key' type='nominal' />
            <column-instance column='[_Demand_or_Supply (copy)_1320680640681058304]' derivation='None' name='[none:_Demand_or_Supply (copy)_1320680640681058304:nk]' pivot='key' type='nominal' />
            <column-instance column='[scenario_name]' derivation='None' name='[none:scenario_name:nk]' pivot='key' type='nominal' />
            <column caption='Scenario Name' datatype='string' name='[scenario_name]' role='dimension' type='nominal' />
            <column caption='Table Name' datatype='string' name='[table_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10gkjpb1b4lygg106228z03zitbj'>
            <column caption='Bool_Commodity_Percent' datatype='boolean' name='[Calculation_2447706439879438338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Commodity Quantity&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Percent of Total&quot;' />
            </column>
            <column caption='Potential Quantity' datatype='real' name='[Calculation_4459689573049090058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_potential&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_potential&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Optimal Quantity' datatype='real' name='[Calculation_4459689573049323531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_optimal&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_optimal&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Optimal Quantity Percentage' datatype='real' name='[Calculation_4459689573049798669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4459689573049323531] / [Calculation_4459689573049090058]' />
            </column>
            <column caption='Non-Optimal Quantity Percentage' datatype='real' name='[Calculation_4459689573050040334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Calculation_4459689573049798669]' />
            </column>
            <column caption='_Demand_or_Supply' datatype='string' name='[Calculation_532832186146295808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; &#13;&#10;OR [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; &#13;&#10;OR [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_input_optimal&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;ELSEIF [measure] = &apos;processor_output_optimal&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
            </column>
