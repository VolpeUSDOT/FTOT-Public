            </column>
            <column-instance column='[Cost Bin Ceiling (copy)_3690137004044406787]' derivation='Attribute' name='[attr:Cost Bin Ceiling (copy)_3690137004044406787:qk]' pivot='key' type='quantitative' />
            <column-instance column='[co2]' derivation='Count' name='[cnt:co2:qk]' pivot='key' type='quantitative' />
            <column aggregation='None' caption='CO2 Histogram' datatype='integer' name='[co2 (bin)]' role='dimension' type='ordinal'>
