            <column-instance column='[COMMODITY]' derivation='None' name='[none:COMMODITY:nk]' pivot='key' type='nominal' />
            <column-instance column='[NET_SOURCE_NAME]' derivation='None' name='[none:NET_SOURCE_NAME:nk]' pivot='key' type='nominal' />
