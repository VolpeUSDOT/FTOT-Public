            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0w6r3991xjsayc1h2x9ss08urjyr'>
            <column caption='_Demand_or_Supply' datatype='string' name='[Calculation_120752824411402243]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; &#13;&#10;OR [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; &#13;&#10;OR [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_input_capacity&apos;&#13;&#10;OR [measure] = &apos;processor_input_optimal&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_output_capacity&apos;&#13;&#10;OR [measure] = &apos;processor_output_optimal&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='_optimal' datatype='real' name='[Calculation_120752824413184007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_120752824411402243] &#13;&#10;&#13;&#10;WHEN &apos;Destination&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;destination_demand_optimal&apos; AND [mode]=&apos;allmodes&apos; THEN [value] END)}  &#13;&#10;&#13;&#10;WHEN &apos;Raw Material Producer&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;rmp_supply_optimal&apos; AND [mode]=&apos;allmodes&apos; THEN [value] END)}&#13;&#10;&#13;&#10;WHEN &apos;Processor (Input)&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;processor_input_optimal&apos; AND [mode]=&apos;allmodes&apos; THEN [value] END)}&#13;&#10;&#13;&#10;WHEN &apos;Processor (Output)&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;processor_output_optimal&apos; AND [mode]=&apos;allmodes&apos; THEN [value] END)}&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='total' datatype='real' name='[Calculation_1805099076977246218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_120752824411402243] &#13;&#10;&#13;&#10;WHEN &apos;Destination&apos; THEN&#13;&#10;    { FIXED [Facility_Name], [Scenario_Name] : &#13;&#10;        SUM(IF [measure] = &apos;destination_demand_potential&apos; THEN [value]/2 END)}&#13;&#10;&#13;&#10;WHEN &apos;Raw Material Producer&apos; THEN&#13;&#10;    { FIXED [Facility_Name], [Scenario_Name] : &#13;&#10;        SUM(IF [measure] = &apos;rmp_supply_potential&apos; THEN [value]/2 END)}&#13;&#10;&#13;&#10;WHEN &apos;Processor (Input)&apos; THEN&#13;&#10;    { FIXED [Facility_Name], [Scenario_Name] :&#13;&#10;        SUM(IF [measure] = &apos;processor_input_capacity&apos; AND NOT ISNULL([value]) THEN [value]/2&#13;&#10;            ELSEIF [measure] = &apos;processor_input_optimal&apos; THEN [value]/2&#13;&#10;            END)} // Use capacity if available. Otherwise, just use the optimal quantity for sizing.&#13;&#10;&#13;&#10;WHEN &apos;Processor (Output)&apos; THEN&#13;&#10;    { FIXED [Facility_Name], [Scenario_Name] :&#13;&#10;        SUM(IF [measure] = &apos;processor_output_capacity&apos; AND NOT ISNULL([value]) THEN [value]/2&#13;&#10;            ELSEIF [measure] = &apos;processor_output_optimal&apos; THEN [value]/2&#13;&#10;            END)} // Use capacity if available. Otherwise, just use the optimal quantity for sizing.&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
