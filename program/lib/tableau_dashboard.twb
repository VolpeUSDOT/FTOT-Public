    <worksheet name='Facilities - Percentage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Optimal vs. Non-Optimal Facilities (as Percent of Available Facilities)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000'>Notes: (1) Bar chart shows supply and demand only. (2) Utilization includes stranded facilities while the main text report excludes stranded facilities.</run>
          </formatted-text>
        </caption>
        <alt-text>
          <formatted-text>
            <run>A stacked bar chart showing the share of facilities that are optimal and non-optimal, by commodity for raw material producers and ultimate destinations.</run>
          </formatted-text>
        </alt-text>
      </layout-options>
      <table>
        <view>
