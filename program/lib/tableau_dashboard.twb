      </column>
      <column caption='_Measure Label - Optimal/Total' datatype='string' name='[Calculation_5813584203819839491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_optimal&apos; THEN &apos;OPTIMAL&apos; &#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;destination_demand_potential&apos; THEN &apos;TOTAL&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;OPTIMAL&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; THEN &apos;TOTAL&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_Parameters Table - Bin' datatype='string' name='[Calculation_655273804522373120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Scenario Information&#13;&#10;IF [measure] = &apos;scenario_name&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_description&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_run_directory&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_schema_version&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;common_data_folder&apos; THEN &apos;Scenario&apos;&#13;&#10;&#13;&#10;// Network-Specific Data&#13;&#10;ELSEIF [measure] = &apos;base_network_gdb&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;disruption_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;impedance_weights_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;speed_time_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;&#13;&#10;// Facility Location Data&#13;&#10;ELSEIF [measure] = &apos;base_rmp_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;ELSEIF [measure] = &apos;base_destination_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;ELSEIF [measure] = &apos;base_processors_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;&#13;&#10;// Facility &amp; Commodity Information&#13;&#10;ELSEIF [measure] = &apos;rmp_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;processors_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;processors_candidate_slate_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;destinations_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;schedule_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;densityFactor&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;&#13;&#10;// Default Units&#13;&#10;ELSEIF [measure] = &apos;default_units_solid_phase&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_liquid_phase&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_distance&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_currency&apos; THEN &apos;Default Units&apos;&#13;&#10;&#13;&#10;// Network Costs&#13;&#10;ELSEIF [measure] = &apos;railroad_class_1_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;truck_base_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_base_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;transloading_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;artificial_link_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;&#13;&#10;// Artificial Links&#13;&#10;ELSEIF [measure] = &apos;road_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;rail_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;water_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_crude_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_prod_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;report_with_artificial_links&apos; THEN &apos;Artificial Links&apos;&#13;&#10;&#13;&#10;// Short Haul Penalites&#13;&#10;ELSEIF [measure] = &apos;rail_short_haul_penalty&apos; THEN &apos;Short Haul Penalties&apos;&#13;&#10;ELSEIF [measure] = &apos;water_short_haul_penalty&apos; THEN &apos;Short Haul Penalties&apos;&#13;&#10;&#13;&#10;// Vehicle Load Size&#13;&#10;ELSEIF [measure] = &apos;truck_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;railcar_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;truck_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;railcar_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_crude_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_prod_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;&#13;&#10;// Emissions and Fuel Use&#13;&#10;ELSEIF [measure] = &apos;truckFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;railcarFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;bargeFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;truckCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;railcarCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;bargeCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;pipelineCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;detailed_emissions_data&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;&#13;&#10;&#13;&#10;// Route Optimization&#13;&#10;ELSEIF [measure] = &apos;permittedModes&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;capacityOn&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;co2_cost_scalar&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;transport_cost_scalar&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;co2_unit_cost&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;backgroundFlowModes&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;minCapacityLevel&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;unMetDemandPenalty (default)&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;maxSeconds&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;fracGap&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;ndrOn&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;solver&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;solver_time_limit&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSE &apos;Other Parameters&apos;&#13;&#10;END' />
      </column>
      <column caption='_DUMMY FIELD' datatype='string' name='[Calculation_6881500271845404676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [table_name] = &apos;commodity_summary&apos; THEN &apos;Commodity&apos; &#13;&#10;&#13;&#10;ELSEIF [table_name] = &apos;config&apos; THEN &apos;Commodity &amp; Mode&apos; &#13;&#10;&#13;&#10;ELSEIF [table_name] = &apos;total_supply_demand_proc&apos; THEN &apos;Summary&apos; &#13;&#10;&#13;&#10;END' />
