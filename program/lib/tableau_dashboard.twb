      </column>
      <column caption='_MEASURE_VMT' datatype='real' name='[Calculation_1097470949062107136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;vehicle-distance_traveled&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_CO2' datatype='real' name='[Calculation_1113233534276460576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;co2&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_DOLLAR_COST' datatype='real' name='[Calculation_1113233534276599841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;transport_cost&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_TOTAL_FLOW' datatype='real' name='[Calculation_1113233534276714530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;total_flow&apos; THEN [value] ELSE 0 end ) }' />
