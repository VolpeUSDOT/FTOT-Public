              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Commodity Quantity&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Percent of Total&quot;' />
            </column>
            <column caption='Potential Quantity' datatype='real' name='[Calculation_4459689573049090058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_potential&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_potential&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Optimal Quantity' datatype='real' name='[Calculation_4459689573049323531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_optimal&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_optimal&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
            </column>
