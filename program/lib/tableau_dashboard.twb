              <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; THEN &apos;Destination&apos;&#13;&#10;ELSEIF [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_input_capacity&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;ELSEIF [measure] = &apos;processor_input_optimal&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_output_capacity&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;ELSEIF [measure] = &apos;processor_output_optimal&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
