      <column caption='_notes - Split 1 - numeric' datatype='real' datatype-customized='true' default-format='n#,##0.00;-#,##0.00' name='[_notes - Split 1 (copy)_5813584203839377418]' role='dimension' type='ordinal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.10gkjpb1b4lygg106228z03zitbj].[notes]'>
