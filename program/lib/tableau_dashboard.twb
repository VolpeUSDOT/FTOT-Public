        <column caption='Processor Measure' datatype='string' name='[_Demand_or_Supply Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Input&quot;'>
          <calculation class='tableau' formula='&quot;Input&quot;' />
          <members>
