        <calculation class='tableau' formula='COUNT(&#13;&#10;    CASE [measure]    &#13;&#10;    WHEN &apos;destination_demand_optimal&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_optimal&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Non-Optimal Facilities' datatype='integer' name='[Calculation_4459689573050621969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4459689573050208271] - [Calculation_4459689573050486800]' />
