            </column>
            <column caption='_optimal FRAC' datatype='real' name='[_optimal (copy)_1805099077003493388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_120752824411402243] &#13;&#10;&#13;&#10;WHEN &apos;Destination&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;           SUM(IF [measure] = &apos;destination_demand_optimal&apos; AND NOT ISNULL([value]) THEN [value]/2 ELSE 0 END) /&#13;&#10;            SUM(IF [measure] = &apos;destination_demand_potential&apos; THEN [value] ELSE 0 END)}&#13;&#10;&#13;&#10;WHEN &apos;Raw Material Producer&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;rmp_supply_optimal&apos; AND NOT ISNULL([value]) THEN [value]/2 ELSE 0 END) /&#13;&#10;            SUM(IF [measure] = &apos;rmp_supply_potential&apos; THEN [value] ELSE 0 END)}&#13;&#10;&#13;&#10;WHEN &apos;Processor (Input)&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;processor_input_optimal&apos; AND NOT ISNULL([value]) THEN [value]/2 ELSE 0 END) /&#13;&#10;            SUM(IF [measure] = &apos;processor_input_capacity&apos; THEN [value] ELSE 0 END)}&#13;&#10;&#13;&#10;WHEN &apos;Processor (Output)&apos; THEN&#13;&#10;    {FIXED [scenario_name], [Facility_Name]:&#13;&#10;        SUM(IF [measure] = &apos;processor_output_optimal&apos; AND NOT ISNULL([value]) THEN [value]/2 ELSE 0 END) /&#13;&#10;            SUM(IF [measure] = &apos;processor_output_capacity&apos; THEN [value] ELSE 0 END)}&#13;&#10;&#13;&#10;END' />
            </column>
