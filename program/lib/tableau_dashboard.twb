    <worksheet name='Facilities - Percentage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Optimal vs. Non-Optimal Facilities (as Percent of Available Facilities)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000'>Note: Utilization in the bar charts </run>
            <run fontcolor='#000000' underline='true'>includes</run>
            <run fontcolor='#000000'> stranded facilities. In contrast, the main text report excludes stranded facilities.</run>
          </formatted-text>
        </caption>
        <_.fcp.AccessibilityEditableAltText.true...alt-text>
          <formatted-text>
            <run>A stacked bar chart showing the share of facilities that are optimal and non-optimal, by commodity for raw material producers and ultimate destinations.</run>
          </formatted-text>
        </_.fcp.AccessibilityEditableAltText.true...alt-text>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_report.csv' name='federated.10gkjpb1b4lygg106228z03zitbj' />
            <datasource caption='facilities_merge (in fGDB)' name='federated.0w6r3991xjsayc1h2x9ss08urjyr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Commodity Quantity' caption='Utilization Units' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Commodity Quantity&quot;'>
              <calculation class='tableau' formula='&quot;Commodity Quantity&quot;' />
              <aliases>
                <alias key='&quot;Commodity Quantity&quot;' value='Commodity Quantity' />
                <alias key='&quot;Facilities&quot;' value='Facilities' />
              </aliases>
            </column>
            <column alias='Absolute Value' caption='Utilization Measure' datatype='string' name='[Utilization Units (copy)_2447706439878758400]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Value&quot;'>
              <calculation class='tableau' formula='&quot;Absolute Value&quot;' />
              <aliases>
