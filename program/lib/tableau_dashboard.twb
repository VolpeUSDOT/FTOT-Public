            <column caption='Bool_Facility_Percent' datatype='boolean' name='[Calculation_2447706439879307265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Facilities&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Percent of Total&quot;' />
