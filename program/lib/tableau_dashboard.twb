      <column caption='_Mode Label - Rail' datatype='string' name='[Calculation_120752824445210639]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mode] = &apos;rail&apos; THEN &apos;Rail&apos; END' />
      </column>
      <column caption='Summary_VMT' datatype='real' name='[Calculation_130885902614827011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &quot;Absolute Value&quot; THEN&#13;&#10;    SUM([Calculation_1097470949062107136])&#13;&#10;WHEN &quot;% Difference&quot; THEN&#13;&#10;    (ZN(SUM([Calculation_1097470949062107136])) - LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST()))&#13;&#10;    / ABS(LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST()))&#13;&#10;WHEN &quot;Difference&quot; THEN&#13;&#10;    ZN(SUM([Calculation_1097470949062107136])) - LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST())&#13;&#10;ELSE 0&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Summary_Tooltip_Units' datatype='string' name='[Calculation_1325465672556584960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[measure button (copy)], &quot;Transport Cost&quot;) THEN &apos;&lt;Sheet name=&quot;Summary Units_Cost&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSEIF CONTAINS([Parameters].[measure button (copy)], &quot;Vehicle-Distance&quot;) THEN &apos;&lt;Sheet name=&quot;Summary Units_VMT&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSE &quot;B&quot;&#13;&#10;END' />
      </column>
      <column caption='_filter - Total vs. Optimal Facilities' datatype='string' name='[Calculation_2045197221849985046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Total vs. Optimal Facilities&apos;' />
      </column>
      <column caption='_Facilities Parameter calc' datatype='real' name='[Calculation_2045197221854609432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;    WHEN &apos;Total vs. Optimal Quantity&apos; THEN SUM([value])&#13;&#10;&#13;&#10;    WHEN &apos;Total vs. Optimal Facilities&apos; THEN COUNT([value])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Perc_Diff_Dollar_Cost' datatype='real' name='[Calculation_2169046210418266115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Summary_VMT (copy)_130885902615666693] / ABS(LOOKUP(ZN(SUM([Calculation_1113233534276599841])), FIRST()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bool_Show_Absolute' datatype='boolean' name='[Calculation_2169046210422738956]' role='dimension' type='nominal'>
