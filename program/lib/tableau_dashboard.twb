            <column alias='Absolute Values' caption='Solution Measure' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Values&quot;'>
              <calculation class='tableau' formula='&quot;Absolute Values&quot;' />
              <aliases>
