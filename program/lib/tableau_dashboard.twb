      <column caption='Bool_Show_Difference' datatype='boolean' name='[Bool_Show_Abs_Difference (copy)_2169046210423283725]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] = &quot;Difference&quot;' />
      </column>
      <column caption='Bool_Facility_Abs_Value' datatype='boolean' name='[Bool_Show_Quantity_Percentage (copy)_4459689573053599766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Facilities&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Absolute Value&quot;' />
      </column>
      <column caption='Button_Absolute Value' datatype='string' name='[Button_Difference (copy)_2208734196978028547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Absolute Value&quot;' />
      </column>
      <column caption='_MEASURE_VMT' datatype='real' name='[Calculation_1097470949062107136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;vehicle-distance_traveled&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_CO2' datatype='real' name='[Calculation_1113233534276460576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;co2&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_DOLLAR_COST' datatype='real' name='[Calculation_1113233534276599841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;transport_cost&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_MEASURE_TOTAL_FLOW' datatype='real' name='[Calculation_1113233534276714530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [mode] : SUM( CASE [measure] WHEN &apos;total_flow&apos; THEN [value] ELSE 0 end ) }' />
      </column>
      <column caption='_Mode Label - Rail' datatype='string' name='[Calculation_120752824445210639]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mode] = &apos;rail&apos; THEN &apos;Rail&apos; END' />
      </column>
      <column caption='Summary_VMT' datatype='real' name='[Calculation_130885902614827011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &quot;Absolute Value&quot; THEN&#13;&#10;    SUM([Calculation_1097470949062107136])&#13;&#10;WHEN &quot;% Difference&quot; THEN&#13;&#10;    (ZN(SUM([Calculation_1097470949062107136])) - LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST()))&#13;&#10;    / ABS(LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST()))&#13;&#10;WHEN &quot;Difference&quot; THEN&#13;&#10;    ZN(SUM([Calculation_1097470949062107136])) - LOOKUP(ZN(SUM([Calculation_1097470949062107136])), FIRST())&#13;&#10;ELSE 0&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Summary_Tooltip_Units' datatype='string' name='[Calculation_1325465672556584960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[measure button (copy)] = &quot;Transport Cost  &quot; OR [Parameters].[measure button (copy)] = &quot;Transport Cost &quot; THEN &apos;&lt;Sheet name=&quot;Summary Units_Cost&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSEIF [Parameters].[measure button (copy)] = &quot;Network Used &quot; OR [Parameters].[measure button (copy)] = &quot;Network Used  &quot; THEN &apos;&lt;Sheet name=&quot;Summary Units_Length&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSEIF [Parameters].[measure button (copy)] = &quot;Vehicle-Distance  &quot; OR [Parameters].[measure button (copy)] = &quot;Vehicle-Distance &quot; THEN &apos;&lt;Sheet name=&quot;Summary Units_VMT&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSEIF [Parameters].[measure button (copy)] = &quot;Fuel Burn  &quot; OR [Parameters].[measure button (copy)] = &quot;Fuel Burn &quot; THEN &apos;&lt;Sheet name=&quot;Summary Units_Fuel Burn&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;ELSEIF [Parameters].[measure button (copy)] = &quot;CO2 Emissions  &quot; OR [Parameters].[measure button (copy)] = &quot;CO2 Emissions &quot; THEN &apos;&lt;Sheet name=&quot;Summary Units_CO2&quot; maxwidth=&quot;300&quot; maxheight=&quot;200&quot; filter=&quot;&lt;All Fields&gt;&quot;&gt;&apos;&#13;&#10;END' />
      </column>
      <column caption='_filter - Total vs. Optimal Facilities' datatype='string' name='[Calculation_2045197221849985046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Total vs. Optimal Facilities&apos;' />
      </column>
      <column caption='_Facilities Parameter calc' datatype='real' name='[Calculation_2045197221854609432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;    WHEN &apos;Total vs. Optimal Quantity&apos; THEN SUM([value])&#13;&#10;&#13;&#10;    WHEN &apos;Total vs. Optimal Facilities&apos; THEN COUNT([value])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Perc_Diff_Dollar_Cost' datatype='real' name='[Calculation_2169046210418266115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Summary_VMT (copy)_130885902615666693] / ABS(LOOKUP(ZN(SUM([Calculation_1113233534276599841])), FIRST()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bool_Show_Absolute' datatype='boolean' name='[Calculation_2169046210422738956]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] = &quot;Absolute Values&quot;' />
      </column>
      <column caption='Button_Difference' datatype='string' name='[Calculation_2208734196976472066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Difference&quot;' />
      </column>
      <column caption='True' datatype='boolean' name='[Calculation_2208734196979937291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='False' datatype='boolean' name='[Calculation_2208734196979982348]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='Bool_Facility_Percent' datatype='boolean' name='[Calculation_2447706439879307265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Facilities&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Percent of Total&quot;' />
      </column>
      <column caption='Bool_Commodity_Percent' datatype='boolean' name='[Calculation_2447706439879438338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Commodity Quantity&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Percent of Total&quot;' />
      </column>
      <column caption='Potential Quantity' datatype='real' name='[Calculation_4459689573049090058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_potential&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_potential&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Optimal Quantity' datatype='real' name='[Calculation_4459689573049323531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [measure]&#13;&#10;    WHEN &apos;destination_demand_optimal&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_optimal&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Non-Optimal Quantity' datatype='real' name='[Calculation_4459689573049466892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4459689573049090058] - [Calculation_4459689573049323531]' />
      </column>
      <column caption='Optimal Quantity Percentage' datatype='real' name='[Calculation_4459689573049798669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4459689573049323531] / [Calculation_4459689573049090058]' />
      </column>
      <column caption='Non-Optimal Quantity Percentage' datatype='real' name='[Calculation_4459689573050040334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_4459689573049798669]' />
      </column>
      <column caption='Potential Facilities' datatype='integer' name='[Calculation_4459689573050208271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([facility_name])' />
      </column>
      <column caption='Optimal Facilities' datatype='integer' name='[Calculation_4459689573050486800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    CASE [measure]    &#13;&#10;    WHEN &apos;destination_demand_optimal&apos; THEN [value]&#13;&#10;    WHEN &apos;rmp_supply_optimal&apos; THEN [value]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Non-Optimal Facilities' datatype='integer' name='[Calculation_4459689573050621969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4459689573050208271] - [Calculation_4459689573050486800]' />
      </column>
      <column caption='Optimal Facility Percentage' datatype='real' name='[Calculation_4459689573051191314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4459689573050486800] / [Calculation_4459689573050208271]' />
      </column>
      <column caption='Non-Optimal Facility Percentage' datatype='real' name='[Calculation_4459689573051260947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_4459689573051191314]' />
      </column>
      <column caption='Bool_Commodity_Abs_Value' datatype='boolean' name='[Calculation_4459689573053382676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;Commodity Quantity&quot; AND [Parameters].[Utilization Units (copy)_2447706439878758400] = &quot;Absolute Value&quot;' />
      </column>
      <column caption='_runtime - seconds' datatype='string' datatype-customized='true' name='[Calculation_4499940493936754688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [table_name] = &apos;runtime&apos; THEN RIGHT([notes],2) END' />
      </column>
      <column caption='_Demand_or_Supply' datatype='string' name='[Calculation_532832186146295808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_potential&apos; &#13;&#10;OR [measure] = &apos;destination_demand_optimal&apos; THEN &apos;Destination&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; &#13;&#10;OR [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;Raw Material Producer&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;processor_input_optimal&apos; THEN &apos;Processor (Input)&apos;&#13;&#10;ELSEIF [measure] = &apos;processor_output_optimal&apos; THEN &apos;Processor (Output)&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='_Commodity &amp; Mode Label' datatype='real' name='[Calculation_5775022157420388355]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [scenario_name], [commodity], [measure], [mode] : SUM([value]) }' />
      </column>
      <column caption='_Measure Label - Optimal/Total' datatype='string' name='[Calculation_5813584203819839491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [measure] = &apos;destination_demand_optimal&apos; THEN &apos;OPTIMAL&apos; &#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;destination_demand_potential&apos; THEN &apos;TOTAL&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_optimal&apos; THEN &apos;OPTIMAL&apos;&#13;&#10;&#13;&#10;ELSEIF [measure] = &apos;rmp_supply_potential&apos; THEN &apos;TOTAL&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_Parameters Table - Bin' datatype='string' name='[Calculation_655273804522373120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Scenario Information&#13;&#10;IF [measure] = &apos;scenario_name&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_description&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_run_directory&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;scenario_schema_version&apos; THEN &apos;Scenario&apos;&#13;&#10;ELSEIF [measure] = &apos;common_data_folder&apos; THEN &apos;Scenario&apos;&#13;&#10;&#13;&#10;// Network-Specific Data&#13;&#10;ELSEIF [measure] = &apos;base_network_gdb&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;disruption_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;impedance_weights_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;ELSEIF [measure] = &apos;speed_time_data&apos; THEN &apos;Network-Specific Data&apos;&#13;&#10;&#13;&#10;// Facility Location Data&#13;&#10;ELSEIF [measure] = &apos;base_rmp_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;ELSEIF [measure] = &apos;base_destination_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;ELSEIF [measure] = &apos;base_processors_layer&apos; THEN &apos;Facility Location Data&apos;&#13;&#10;&#13;&#10;// Facility &amp; Commodity Information&#13;&#10;ELSEIF [measure] = &apos;rmp_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;processors_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;processors_candidate_slate_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;destinations_commodity_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;schedule_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;commodity_mode_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;commodity_density_data&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;ELSEIF [measure] = &apos;densityFactor&apos; THEN &apos;Facility &amp; Commodity Information&apos;&#13;&#10;&#13;&#10;// Default Units&#13;&#10;ELSEIF [measure] = &apos;default_units_solid_phase&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_liquid_phase&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_distance&apos; THEN &apos;Default Units&apos;&#13;&#10;ELSEIF [measure] = &apos;default_units_currency&apos; THEN &apos;Default Units&apos;&#13;&#10;&#13;&#10;// Network Costs&#13;&#10;ELSEIF [measure] = &apos;railroad_class_1_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;truck_base_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_base_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;transloading_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;ELSEIF [measure] = &apos;artificial_link_cost&apos; THEN &apos;Network Costs&apos;&#13;&#10;&#13;&#10;// Artificial Links&#13;&#10;ELSEIF [measure] = &apos;road_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;rail_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;water_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_crude_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_prod_max_artificial_link_dist&apos; THEN &apos;Artificial Links&apos;&#13;&#10;ELSEIF [measure] = &apos;report_with_artificial_links&apos; THEN &apos;Artificial Links&apos;&#13;&#10;&#13;&#10;// Short Haul Penalites&#13;&#10;ELSEIF [measure] = &apos;rail_short_haul_penalty&apos; THEN &apos;Short Haul Penalties&apos;&#13;&#10;ELSEIF [measure] = &apos;water_short_haul_penalty&apos; THEN &apos;Short Haul Penalties&apos;&#13;&#10;&#13;&#10;// Vehicle Load Size&#13;&#10;ELSEIF [measure] = &apos;truck_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;railcar_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_load_solid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;truck_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;railcar_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;barge_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_crude_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;ELSEIF [measure] = &apos;pipeline_prod_load_liquid&apos; THEN &apos;Vehicle Load Size&apos;&#13;&#10;&#13;&#10;// Emissions and Fuel Use&#13;&#10;ELSEIF [measure] = &apos;truckFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;railcarFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;bargeFuelEfficiency&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;truckCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;railcarCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;bargeCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;pipelineCO2Emissions&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;ELSEIF [measure] = &apos;detailed_emissions_data&apos; THEN &apos;Emissions &amp; Fuel Use&apos;&#13;&#10;&#13;&#10;&#13;&#10;// Route Optimization&#13;&#10;ELSEIF [measure] = &apos;permittedModes&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;capacityOn&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;co2_cost_scalar&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;transport_cost_scalar&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;co2_unit_cost&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;backgroundFlowModes&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;minCapacityLevel&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;unMetDemandPenalty (default)&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;maxSeconds&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;fracGap&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;ndrOn&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;solver&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSEIF [measure] = &apos;solver_time_limit&apos; THEN &apos;Route Optimization&apos;&#13;&#10;ELSE &apos;Other Parameters&apos;&#13;&#10;END' />
