          <datasource-dependencies datasource='federated.0biw4sc0geh7th15l7l8h1cmbo8h'>
            <column caption='From Type_To Type' datatype='string' name='[Calculation_10414634158882816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [from_facility_type] = &apos;raw_material_producer&apos; AND [to_facility_type] = &apos;processor&apos; THEN &apos;RMP - Processor&apos;&#13;&#10;ELSEIF [from_facility_type] = &apos;raw_material_producer&apos; AND [to_facility_type] = &apos;ultimate_destination&apos; THEN &apos;RMP - Ultimate Dest&apos;&#13;&#10;ELSEIF [from_facility_type] = &apos;processor&apos; AND [to_facility_type] = &apos;ultimate_destination&apos; THEN &apos;Processor - Ultimate Dest&apos;&#13;&#10;ELSE [from_facility_type] + &quot; - &quot; + [to_facility_type]&#13;&#10;END' />
