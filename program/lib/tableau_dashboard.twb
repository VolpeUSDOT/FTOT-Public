        <calculation class='tableau' formula='IF REGEXP_MATCH(TRIM( SPLIT( [notes], &quot; &quot;, 1 ) ), &apos;[a-zA-Z]&apos;) = TRUE &#13;&#10;    THEN TRIM( SPLIT( [notes], &quot; &quot;, 1 ) )&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
