            <column caption='Miles Bin Size' datatype='integer' datatype-customized='true' name='[Parameter 6]' param-domain-type='range' role='measure' type='quantitative' value='200'>
              <calculation class='tableau' formula='200' />
              <range granularity='1' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0biw4sc0geh7th15l7l8h1cmbo8h'>
            <column caption='From Type_To Type' datatype='string' name='[Calculation_10414634158882816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [from_facility_type] = &apos;raw_material_producer&apos; AND [to_facility_type] = &apos;processor&apos; THEN &apos;RMP - Processor&apos;&#13;&#10;ELSEIF [from_facility_type] = &apos;raw_material_producer&apos; AND [to_facility_type] = &apos;ultimate_destination&apos; THEN &apos;RMP - Ultimate Dest&apos;&#13;&#10;ELSEIF [from_facility_type] = &apos;processor&apos; AND [to_facility_type] = &apos;ultimate_destination&apos; THEN &apos;Processor - Ultimate Dest&apos;&#13;&#10;ELSE [from_facility_type] + &quot; - &quot; + [to_facility_type]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;processor - ultimate_destination&quot;' value='processor - ultimate destination' />
                <alias key='&quot;raw_material_producer - processor&quot;' value='raw material producer - processor' />
              </aliases>
            </column>
            <column caption='Chart Symbology Calc' datatype='string' name='[Calculation_2725522248932995072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &apos;mode&apos; THEN [mode]&#13;&#10;When &apos;Commodity&apos; THEN [commodity_name]&#13;&#10;WHEN &apos;Scenario Name&apos; THEN [scenario_name]&#13;&#10;WHEN &apos;In Optimal Solution?&apos; THEN [in_solution]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;multimodal&quot;' value='Multimodal' />
                <alias key='&quot;N&quot;' value='Non-Optimal' />
                <alias key='&quot;pipeline_crude_trf_rts&quot;' value='Pipeline (crude)' />
                <alias key='&quot;pipeline_prod_trf_rts&quot;' value='Pipeline (product)' />
                <alias key='&quot;rail&quot;' value='Rail' />
                <alias key='&quot;road&quot;' value='Road' />
                <alias key='&quot;water&quot;' value='Water' />
                <alias key='&quot;Y&quot;' value='Optimal' />
              </aliases>
            </column>
            <column caption='Is Optimal' datatype='integer' name='[Calculation_5781777543346483200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [in_solution] == &quot;Y&quot; THEN 1 ELSE 0 END' />
              <aliases>
